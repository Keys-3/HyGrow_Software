{
  "name": "hygrow-root",
  "version": "1.0.0",
  "description": "Command runner for the independent HyGrow frontend and backend packages",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run start-frontend\" \"npm run start-backend\"",
    "dev": "concurrently --kill-others-on-fail \"npm run dev-frontend\" \"npm run dev-backend\"",
    "start-frontend": "npm --prefix FrontEnd start -- --web",
    "start-backend": "npm --prefix BackEnd start",
    "dev-frontend": "npm --prefix FrontEnd start",
    "dev-backend": "npm --prefix BackEnd run dev",
    "install-all": "npm ci && npm --prefix FrontEnd ci && npm --prefix BackEnd ci",
    "clear-cache": "npm --prefix FrontEnd start -- --clear"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
