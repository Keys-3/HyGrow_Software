  },
  "main": "index.js",
  "dependencies": {
    "@gradio/client": "^2.3.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "private": true
}
