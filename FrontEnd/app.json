{
  "expo": {
    "name": "HyGrow",
    "slug": "hygrow-root",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hygrow-icon.png",
    "scheme": "farmhelp",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hygrow-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-status-bar",
      "./plugins/withLocalTelemetry"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmhelp.app",
      "icon": "./assets/images/hygrow-icon.png",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "HyGrow reads sensor measurements from your hydroponics device on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "icon": "./assets/images/hygrow-icon.png",
      "package": "com.prithvi.hygrow",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/hygrow-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/hygrow-icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf94f005-a95e-4186-bac2-65e639a12229"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cf94f005-a95e-4186-bac2-65e639a12229"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
