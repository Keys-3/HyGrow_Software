rules_version = '2';

// Firebase Storage rules for HyGrow & Hugging Face AI scans
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function signedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isUnder10MB() { return request.resource.size <= 10 * 1024 * 1024; }

    // User profile images and avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && isImage() && isUnder10MB();
    }

    // Market listing product images
    match /market/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && isUnder10MB();
    }

    // Hugging Face AI disease detection scans
    match /disease_scans/{fileName} {
      allow read: if true;
      allow write: if isImage() && isUnder10MB();
    }

    // General application assets fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isUnder10MB();
    }
  }
}
